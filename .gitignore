# StockWarren Git Ignore

# Environment & Secrets
.env
*.pem
*.key
credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/

# ML Models (large files)
data/models/*.pkl
data/models/*.joblib
data/models/*.npz

# Logs & Data
logs/*.log
logs/*.log.*
logs/*.out
logs/*.csv
logs/trades/
data/*.csv
data/scheduled_trades.json

# Runtime safety state (operator-managed, not source) — per account too
data/KILL_SWITCH*.lock
data/operator_overrides*.json
data/models/

# Per-account user state and fetched caches — runtime, not source.
# Watchlists are seeded from [watchlist] in settings.ini and then owned by the
# user; company profiles are a rebuildable yfinance cache.
data/watchlist_*.json
data/company_profiles.json
data/decisions_*.jsonl*

# Keep directories
!logs/.gitkeep
!data/.gitkeep
!data/models/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Build
build/
dist/
