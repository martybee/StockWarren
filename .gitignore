# StockWarren Git Ignore

# Environment & Secrets
.env
*.pem
*.key
credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/

# ML Models (large files)
data/models/*.pkl
data/models/*.joblib
data/models/*.npz

# Logs & Data
logs/*.log
logs/*.log.*
logs/*.out
logs/*.csv
logs/trades/
data/*.csv
data/scheduled_trades.json

# Runtime safety state (operator-managed, not source)
data/KILL_SWITCH.lock
data/operator_overrides.json

# Keep directories
!logs/.gitkeep
!data/.gitkeep
!data/models/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Build
build/
dist/
