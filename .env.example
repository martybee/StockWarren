# StockWarren Environment Configuration
# Copy this file to .env and fill in your values

# Alpaca API Keys — one pair PER paper account (multi-account trading).
# Create additional paper accounts in the Alpaca dashboard; each has its own keys.
# Get yours at: https://app.alpaca.markets/
# Account "alpha" (also the default single-account keys):
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
# Account "beta":
ALPACA_API_KEY_2=
ALPACA_SECRET_KEY_2=
# Account "gamma":
ALPACA_API_KEY_3=
ALPACA_SECRET_KEY_3=

# Paper trading (default) or live trading
# Set to "live" for real money trading
ALPACA_ENVIRONMENT=paper

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=

# Email Notifications (optional)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
