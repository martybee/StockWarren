<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  StockWarren launchd service for macOS — configured for martynbar (engine M6).

  Runs DEFAULT mode (bots + dashboard). STOCKWARREN_SUPERVISED=1 tells
  main.py it is running under supervision, which:
    - arms the crash-loop breaker (>= 3 supervised restarts within one hour
      trips every account's kill switch; process comes up dashboard-only)
    - applies the auto-resume policy: bots start only if NO kill switch is
      present and NO state file was quarantined during load
    - attaches `caffeinate -s -w <pid>` so the Mac stays awake exactly as
      long as the process lives (no more hand-run caffeinate)

  Install:
    cp setup/services/com.stockwarren.bot.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.stockwarren.bot.plist

  Runbook (also in CLAUDE.md):
    launchctl list | grep stockwarren                     # running?
    launchctl kickstart -k gui/$(id -u)/com.stockwarren.bot   # force restart
    launchctl unload ~/Library/LaunchAgents/com.stockwarren.bot.plist  # stop
    tail -f /Users/martynbar/StockWarren/logs/launchd.out.log

  KeepAlive restarts on crash (kill -9, panic) but NOT on clean exit, so a
  deliberate shutdown (SIGTERM -> graceful exit 0) stays down.
  RunAtLoad starts it at load time and on login.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockwarren.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/martynbar/StockWarren/venv/bin/python</string>
        <string>/Users/martynbar/StockWarren/main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/martynbar/StockWarren</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/martynbar/StockWarren/venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>STOCKWARREN_SUPERVISED</key>
        <string>1</string>
    </dict>

    <!-- Auto-restart if it crashes -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Wait at least 30 seconds between restart attempts -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Start when loaded / when the user logs in -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/Users/martynbar/StockWarren/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/martynbar/StockWarren/logs/launchd.err.log</string>

    <!-- Give a graceful SIGTERM shutdown 30s before SIGKILL -->
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <!-- Process limits -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>

    <!-- Nice priority (slightly lower than default) -->
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
